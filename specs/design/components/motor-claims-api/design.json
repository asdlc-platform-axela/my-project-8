{
  "name": "motor-claims-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "motor-claims-api",
  "entrypoint": "deployment/service",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F1.4",
    "F1.5",
    "F1.6",
    "F1.7",
    "F1.8",
    "F1.9",
    "F1.10",
    "F1.11",
    "F1.12",
    "F1.13",
    "F1.14",
    "F1.15",
    "F2.1",
    "F2.2",
    "F2.3",
    "F2.4"
  ],
  "description": "Owns the claimant's motor claims: creating and updating a draft, attaching the driving-licence and bank-page documents, submitting a completed claim (immutable from then on), and listing and reading the caller's own claims. Stores claims and attachments in its own Postgres database. Does not process, approve or pay claims — that is outside this build.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "claims-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "my-project-8-claims-db",
        "envBindings": {
          "dbname": "CLAIMS_DB_DBNAME",
          "host": "CLAIMS_DB_HOST",
          "password": "CLAIMS_DB_PASSWORD",
          "port": "CLAIMS_DB_PORT",
          "user": "CLAIMS_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "thunder-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "my-project-8-thunder-auth",
        "envBindings": {
          "client_id": "THUNDER_AUTH_CLIENT_ID",
          "issuer": "THUNDER_AUTH_ISSUER",
          "jwks_url": "THUNDER_AUTH_JWKS_URL",
          "resource": "THUNDER_AUTH_RESOURCE",
          "scopes": "THUNDER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "api-management",
    "thunder-authentication"
  ]
}
